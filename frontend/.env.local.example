# ==============================================================================
# EventHora Frontend — Environment Variables Template
# ==============================================================================
# Copy this file to '.env.local' for local development:
#   cp .env.local.example .env.local
#
# When deploying to Vercel:
#   Add these variables in Vercel Dashboard -> Settings -> Environment Variables
# ==============================================================================

# ─── 1. Backend API Base URL ──────────────────────────────────────────────────
# Local dev:  http://localhost:8080 (default Spring Boot port)
# Render:     https://your-backend-service.onrender.com (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ─── 2. Razorpay Public Key ID ────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com > Settings > API Keys
# Note: Only put the KEY ID (rzp_test_... or rzp_live_...) here.
#       NEVER put the Key Secret on the frontend!
# Use rzp_test_... during resume/portfolio demo phase.
# Switch to rzp_live_... for actual production release for RIC.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
