# ==============================================================================
# EventHora Backend — Environment Variables Template
# ==============================================================================
# Copy this file to '.env' for local development or Docker Compose:
#   cp .env.example .env
#
# When deploying to Render:
#   Add these in Render Dashboard -> Environment -> Environment Variables
# ==============================================================================

# ─── 1. Profile & Mode ────────────────────────────────────────────────────────
# SPRING_PROFILES_ACTIVE=prod (set to 'prod' on Render; defaults to 'dev' locally)
SPRING_PROFILES_ACTIVE=dev

# DEMO_MODE=true allows OTP "123456" for testing without server logs.
# Set DEMO_MODE=true for your resume/portfolio phase; DEMO_MODE=false for live RIC release.
DEMO_MODE=false

# ─── 2. Database (PostgreSQL / Neon) ──────────────────────────────────────────
# For local Docker dev, use POSTGRES_* variables below.
# For Render (using Neon.tech), set DATABASE_URL directly to your JDBC URL:
# DATABASE_URL=jdbc:postgresql://ep-example-123456.region.aws.neon.tech/eventhora?sslmode=require
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eventhora

# ─── 3. Redis (Upstash / Local) ───────────────────────────────────────────────
# Local dev: defaults to localhost:6379 (no password, SSL false)
# For Render with Upstash Redis cloud:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ─── 4. CORS Origins ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend URLs (no spaces around commas):
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# ─── 5. Security / JWT ────────────────────────────────────────────────────────
JWT_SECRET=your_random_32_plus_character_secret_here

# ─── 6. Razorpay Payment Gateway ──────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com > Settings > API Keys
# Use rzp_test_... for resume/demo phase; switch to rzp_live_... for RIC production
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Webhook secret from Razorpay Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── 7. AWS S3 Storage (Optional / File Uploads) ──────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=your_aws_region
S3_BUCKET_NAME=your_s3_bucket_name
